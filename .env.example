# ================================================================
# Agent Hedging Desk - copy to .env and fill in. Never committed.
# ================================================================

# ---------- Agent B: the hedging desk (writes the put, gets paid) ----------
DESK_PORT=4040
# Desk wallet: RECEIVES the x402 premium and SENDS the on-chain payout.
# Needs a little test USDC on Base Sepolia to fund payouts. Faucet: https://faucet.circle.com
DESK_PRIVATE_KEY=

# ---------- Agent A: the client (buys protection, pays premium) ----------
DESK_URL=http://localhost:4040
# Client wallet: PAYS the x402 premium, RECEIVES the payout.
# Fund with test USDC on Base Sepolia (same faucet).
CLIENT_PRIVATE_KEY=

# ---------- x402 / chain ----------
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=https://x402.org/facilitator
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Base Sepolia USDC (used for the payout leg)
PAYOUT_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ---------- Contract terms (client-side defaults; overridable via CLI) ----------
PAIR=BNBUSDT
NOTIONAL_USD=100
STRIKE_PCT=0.05         # strike is this many % below spot. At ~41% vol / 90s expiry
                        # this is ~0.7 sigma out, which the client agent will buy.
                        # 2.5 here is ~36 sigma out and gets declined.
EXPIRY_SECONDS=90       # demo-compressed expiry
DESK_FEE_BPS=150        # desk markup over Black-Scholes fair value
MAX_PREMIUM_PCT=6       # client refuses a quote whose premium exceeds this % of notional

# Payout cap per contract (this is a put SPREAD, not a naked put). Bounds the desk's
# liability so collateral can be checked - the desk refuses to quote unless it holds
# this much free USDC. Keep it at or below your faucet balance.
MAX_PAYOUT_USD=2

# ---------- Hedge leg ----------
# simulated = desk tracks a synthetic short perp + mark-to-market PnL (always works)
# manual    = desk prints the exact USDdS-M futures order to place in your MCP client on camera
HEDGE_MODE=simulated

# ---------- Binance market data (public, no auth) ----------
BINANCE_REST=https://api.binance.com
BINANCE_FAPI=https://fapi.binance.com

# ---------- Model (REQUIRED for the client) ----------
# The client agent's buy/decline is a model judgment, not a threshold - it will not
# start without a key. Also used for the one-line outcome narration.
#
# Any OpenAI-compatible endpoint (default):
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.rntm.sh/v1
LLM_MODEL=free
LLM_API_KEY=
#
# Or Anthropic instead - flip these three, no code change:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# LLM_API_KEY=sk-ant-...
